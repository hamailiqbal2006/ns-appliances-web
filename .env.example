# Create a free Supabase project, then run both SQL migrations before adding its Project URL and publishable/anon key here.
# Keep this file as a template; put real values only in an ignored .env.local file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Required after local development: the single deployed site origin, for example https://shop.example.com.
# Local recovery emails deliberately use http://localhost:3000 while this remains unset.
SITE_URL=

# Never expose or use SUPABASE_SERVICE_ROLE_KEY in the browser or in this admin portal.
